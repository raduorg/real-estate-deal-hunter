# Email Configuration (IMAP)
EMAIL_USER=your@email.com
EMAIL_PASSWORD=your-app-specific-password
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993

# Vision Evaluation (local Ollama — no API key needed)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_VISION_MODEL=gemma4:26b
VISION_TIMEOUT_SECONDS=300
VISION_MAX_RETRIES=3
VISION_MAX_IMAGES=10
VISION_IMAGE_TIMEOUT_SECONDS=20
VISION_TEMPERATURE=0.2

# Optional cloud fallbacks (unused while Ollama is primary)
OPENAI_API_KEY=sk-...
GOOGLE_AI_API_KEY=AIza...

# Notification Tokens
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_CHAT_ID=987654321

# Proxy Configuration (optional, for fallback scraping)
PROXY_URL=http://user:pass@proxy-server:8080

# Target Search Parameters
TARGET_CITY=Bucharest
MAX_PRICE_EUR=150000
MIN_SQM=50

# Database
DATABASE_PATH=data/listings.db

# Polling
EMAIL_POLL_INTERVAL_SECONDS=60

# Early exit / zone financial gate
EARLY_EXIT_CEILING_MULTIPLIER=1.30
EARLY_EXIT_FLOOR_MULTIPLIER=0.50
ZONE_FALLBACK_CITY=Bucuresti

# Stage 6: Valuation & deal scoring
DEAL_THRESHOLD_PERCENT=10
DEAL_MAX_DISCOUNT_PERCENT=40
DEAL_DISCOUNT_WEIGHT=0.80
DEAL_CONDITION_WEIGHT=0.20

# Extraction / Page Fetching
FETCH_MIN_DELAY_SECONDS=6
FETCH_MAX_DELAY_SECONDS=12
HTTP_TIMEOUT_SECONDS=30
FETCH_MAX_RETRIES=3
MAX_IMAGES_PER_LISTING=15
